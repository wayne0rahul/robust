# ====================================================================
# Multi-Agent Content Creation System - Environment Variables
# ====================================================================

# Default LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=groq

# 1. Groq API Configuration (Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API Configuration (Free tier: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 3. Web Search Tool
# Tavily API (Free tier: 1000 searches/mo at https://tavily.com)
# If left empty, system automatically falls back to DuckDuckGo search (100% free, no key needed)
TAVILY_API_KEY=

# 4. LangSmith Observability & Tracing (Optional: https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=content-creation-system

